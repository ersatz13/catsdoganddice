    def get_kibble_image(self, kibbles: float) -> tk.PhotoImage | None:
        if not self.kibble_images:
            return None
        count = max(0, int(kibbles))
        if count <= 0:
            return None
        if count >= 30:
            key = 30
        elif count >= 20:
            key = 20
        elif count >= 15:
            key = 15
        elif count >= 10:
            key = 10
        else:
            key = max(1, count)
        return self.kibble_images.get(key)

