            self.table_labels.append(slot)

        self.dice_vars: List[tk.BooleanVar] = []
        self.dice_checks: List[tk.Checkbutton] = []
        self.dice_frames: List[tk.Frame] = []
        self.reveal_job = None
        self.drag_index = None
