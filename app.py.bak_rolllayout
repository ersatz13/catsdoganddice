            name_lbl.pack(side="left", padx=(0, 8))
            box = tk.Frame(
                row,
                width=box_size,
                height=box_size,
                bg=self.theme["panel_dark"],
            )
            box.pack_propagate(False)
            box.pack(side="left")
            roll_lbl = tk.Label(
                box,
                text="-",
                font=self.theme["body_font"],
                bg=self.theme["panel_dark"],
                fg=self.theme["text"],
