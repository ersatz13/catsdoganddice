    def _card_button(
        self,
        frame: tk.Frame,
        player: Player,
        card: Card,
        index: int,
        kind: str,
        horizontal: bool = False,
        animate: bool = False,
        grid: tuple[int, int] | None = None,
    ) -> None:
        game = self.game
        if not game:
            return
        container = tk.Frame(frame, bg=self.theme["shop_bg"] if self.in_shop else self.theme["panel_dark"])
        def on_buy(_event=None) -> None:
            self.buy_card(player, card, index, kind)
        if grid is not None:
            row, col = grid
            container.grid(row=row, column=col, padx=6, pady=4, sticky="w")
        elif horizontal:
            container.pack(side="left", padx=6, pady=2)
        else:
            container.pack(anchor="w", pady=2)
        img = self.get_card_image(card)
        if img:
            if animate:
                canvas = tk.Canvas(
                    container,
                    width=img.width(),
                    height=img.height(),
                    bg=self.theme["shop_bg"] if self.in_shop else self.theme["panel_dark"],
                    highlightthickness=0,
                )
                canvas.pack(side="left")
                image_id = canvas.create_image(
                    img.width() // 2, img.height() // 2, image=img
                )
                cover = canvas.create_rectangle(
                    0,
                    0,
                    img.width(),
                    img.height(),
                    fill=self.theme["shop_bg"] if self.in_shop else self.theme["panel_dark"],
                    outline="",
                )

                def step(i: int) -> None:
                    total = 8
                    if i > total:
                        canvas.delete(cover)
                        return
                    width = img.width()
                    height = img.height()
                    right = int(width * (i / total))
                    canvas.coords(cover, right, 0, width, height)
                    canvas.after(35, lambda: step(i + 1))

                self.play_sound(self.flip_sound)
                canvas.after(40, lambda: step(0))
                canvas.bind(
                    "<Button-1>", on_buy
                )
                self.attach_card_tooltip(canvas, card)
                btn = None
            else:
                btn = tk.Button(
                    container,
                    image=img,
                    command=on_buy,
                    bg=self.theme["shop_bg"] if self.in_shop else self.theme["panel_dark"],
                    activebackground=self.theme["shop_bg"] if self.in_shop else self.theme["panel_dark"],
                    relief="flat",
                    borderwidth=0,
                )
                btn.image = img
        else:
            btn = tk.Button(
                container,
                text=card.name,
                command=on_buy,
                font=self.theme["body_font"],
                bg=self.theme["panel"] if not self.in_shop else self.theme["shop_bg"],
                fg=self.theme["text"],
                activebackground=self.theme["btn_active"],
                relief="flat",
                anchor="w",
            )
        if btn:
            btn.pack(side="left")
            self.attach_card_tooltip(btn, card)
            btn.bind("<Button-1>", on_buy, add="+")
        self.attach_card_tooltip(container, card)
        container.bind("<Button-1>", on_buy, add="+")
        if kind == "dog" and player.free_dog_claims > 0:
            free_label = tk.Label(
                container,
                text="FREE",
                font=self.theme["body_font"],
                bg=self.theme["shop_bg"] if self.in_shop else self.theme["panel_dark"],
                fg=self.theme["accent"],
            )
            free_label.pack(side="left", padx=6)
            self.attach_card_tooltip(free_label, card)
            free_label.bind("<Button-1>", on_buy)

