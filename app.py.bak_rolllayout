    def render_hand(self) -> None:
        game = self.game
        if not game:
            return
        player = self.players[game.turn_index] if self.players else None
        if player and player.focus_overrides:
            valid_ids = {id(d) for d in game.current_hand}
            stale = [k for k in player.focus_overrides.keys() if k not in valid_ids]
            if stale:
                for k in stale:
                    player.focus_overrides.pop(k, None)
        for widget in self.hand_frame.winfo_children():
            widget.destroy()
        self.dice_vars = []
        self.dice_checks = []
        self.dice_frames = []
        row = tk.Frame(self.hand_frame, bg=self.theme["panel_dark"])
        row.pack(anchor="center")
        starlight_active = self.is_starlight_active(player)
        for i, die in enumerate(game.current_hand):
            display_color = self.effective_die_color(die, player)
            var = tk.BooleanVar(value=False)
            self.dice_vars.append(var)
            frame = tk.Frame(
                row,
                highlightthickness=2,
                highlightbackground=self.theme["panel_dark"],
                bg=self.theme["panel_dark"],
            )
            frame.pack(side="left", padx=2)
            self.dice_frames.append(frame)
            if starlight_active and die.color == "purple" and self.purple_wild_image:
                cb = tk.Checkbutton(
                    frame,
                    image=self.purple_wild_image,
                    variable=var,
                    width=64,
                    height=64,
                    indicatoron=0,
                    bg=self.theme["panel_dark"],
                    activebackground=self.theme["panel_dark"],
                    borderwidth=0,
                )
            elif (
                display_color in self.dice_images
                and die.value in self.dice_images[display_color]
            ):
                cb = tk.Checkbutton(
                    frame,
                    image=self.dice_images[display_color][die.value],
                    variable=var,
                    width=64,
                    height=64,
                    indicatoron=0,
                    bg=self.theme["panel_dark"],
                    activebackground=self.theme["panel_dark"],
                    borderwidth=0,
                )
            else:
                text = f"{display_color} {die.value}"
                cb = tk.Checkbutton(
                    frame,
                    text=text,
                    variable=var,
                    bg=display_color,
                    fg="black",
                    width=12,
