    def scale_dice_images(self, images: dict, factor: int = 2) -> dict:
        scaled: dict[str, dict[int, tk.PhotoImage]] = {}
        if factor <= 1:
            return images
        for color, faces in images.items():
            scaled[color] = {}
            for value, img in faces.items():
                if img:
                    scaled[color][value] = img.subsample(factor, factor)
        return scaled

