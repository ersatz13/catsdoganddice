        title_img = self.ui_images.get("roll_title")
        if title_img:
            title = tk.Label(self.first_player_frame, image=title_img, bg=self.theme["panel_dark"])
            title.image = title_img
        else:
            title = tk.Label(
                self.first_player_frame,
