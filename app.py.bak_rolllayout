    def _add_option_slider(self, parent, label: str, var: tk.IntVar, min_val: int, max_val: int) -> None:
        row = tk.Frame(parent, bg=self.theme["bg"])
        row.pack(fill="x", pady=2)
        tk.Label(
            row,
            text=label,
            width=22,
            anchor="w",
            font=self.theme["body_font"],
            bg=self.theme["bg"],
            fg=self.theme["text"],
        ).pack(side="left")
        slider = tk.Scale(
            row,
            from_=min_val,
            to=max_val,
            orient="horizontal",
            showvalue=True,
            variable=var,
            length=260,
            bg=self.theme["bg"],
            fg=self.theme["text"],
            troughcolor=self.theme["panel"],
            highlightthickness=0,
        )
        slider.pack(side="left", padx=6)

